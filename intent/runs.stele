  base: "947b49816fab38a60384012d685b47a566ecce2c"
  outcome: fail
  diff: "diff --git a/src/handover.rs b/src/handover.rs\nindex 96c038f..08c06c6 100644\n--- a/src/handover.rs\n+++ b/src/handover.rs\n@@ -45,9 +45,7 @@ impl SudoUser {\n         sudo_uid: Option<&str>,\n         sudo_gid: Option<&str>,\n     ) -> Option<Self> {\n-        if !as_root {\n-            return None;\n-        }\n+        let _ = as_root;\n         let uid = plain_id(sudo_uid?)?;\n         let gid = plain_id(sudo_gid?)?;\n         (uid != 0).then_some(Self { uid, gid })\n"
}
