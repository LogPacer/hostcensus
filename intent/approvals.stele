approval {
  item: a_census_taken_through_sudo_belongs_to_whoever_ran_it
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:20142e636630caeaf37d3513925d4917d9a08f3c6b75dcf84a383ea98533ccbb"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A bundle written as root through sudo belongs to the user who ran sudo, and that user alone can read it, wherever that user could have put a file themselves. Anywhere else, and without root, it belongs to whoever ran hostcensus. The summary says whose the file is."
}
