approval {
  item: cli
  kind: channel
  action: approve
  by: "MortenHusted"
  digest: "sha256:b02c601c6ad211a9029bddaaff4b7a5e6587505a61418ba3f3d190591cfde771"
  digest_version: 1
  text: "Run the hostcensus binary from a shell on the host."
}
approval {
  item: takes_a_census_of_one_host
  kind: intent
  action: approve
  by: "MortenHusted"
  digest: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"
  digest_version: 1
  text: "hostcensus lists what one host runs and which logs it produces, in one file, and says what it could not see."
}
approval {
  item: reveals_no_more_than_a_census_needs
  kind: intent
  action: approve
  by: "MortenHusted"
  digest: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"
  digest_version: 1
  text: "A census reaches nothing outside the host, reads no log content, and leaves command-line arguments and label values out of the bundle unless asked for them."
}
approval {
  item: a_bundle_is_a_record_a_person_can_check
  kind: intent
  action: approve
  by: "MortenHusted"
  digest: "sha256:0a3579ccbe7a92f103f0d2d02556632710a58a6d1649e47162d2089244d0681b"
  digest_version: 1
  text: "A bundle is a plain, versioned record of one census, and it shows when its observations were changed after the census."
}
approval {
  item: coverage_is_stated_beside_the_observations
  kind: intent
  action: approve
  by: "MortenHusted"
  digest: "sha256:c37aba02161e85042a40afeaf5d1e29d0971768599cf56bbb262edea32382eea"
  digest_version: 1
  text: "What is already collected is recorded as statements about sources the census found, kept apart from what the census observed."
}
approval {
  item: a_census_writes_one_bundle
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:99cdb427912e559fd976c231787363469dbc2769b9cc806101716e492b11703d"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A census writes one bundle: to the path given, to standard output when the path is -, and otherwise to a file named after the host and the time. It says on standard error where the bundle went and that nothing was sent."
}
approval {
  item: a_census_never_replaces_a_file
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:cd876894d813f6730e07ee1aa765bb5caa34e22e30371936fd4e7bfa961358c8"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A census fails rather than replace an existing file, and leaves that file as it was."
}
approval {
  item: every_scanner_reports_how_it_went
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:e9279b31514a1a8e5d9282f5ffe6fd01e93ae9631294d6934fbc44906453477b"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "The bundle names every scanner that applies to the host, each as complete, partial or unavailable."
}
approval {
  item: a_log_file_is_recognised_by_its_name
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:70afeaef278db89ad26fc731c12f2e54417981112d19676be6b2473d3094e642"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A file under a scan path is listed as a log file when its name ends in an allowed extension or in _log, or is the name of a system log such as syslog, messages or secure. Other files in the same directory are not listed."
}
approval {
  item: old_and_excluded_log_files_are_left_out
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:f4d4b766fc76bca56cbc77fd7b11ea34693cf08e949158937166cf8a5c23690d"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A log file is left out when it was not written to within the age limit, or when an exclude pattern matches it."
}
approval {
  item: rotated_copies_belong_to_their_log_file
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:a22634bd84301bc735c119ee84a650a21c4395326c23d85542d4822f973070d6"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A rotated copy is listed under the log file it was rotated from, and is not a log file of its own."
}
approval {
  item: log_content_is_never_read
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:575d08c4a4c65c1a65de77b67ea94bdedafc05940ba487866ef942bcc22fd11a"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "A log file is described from its directory entry. A file hostcensus may not open is listed all the same."
}
approval {
  item: a_process_is_recorded_by_its_executable
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:81a97a4a5a6a4b8a54bf08a26a218ae4d75c1ff6873286f91b53c2ffe963c9b8"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "A process is recorded by its executable alone. Its arguments are recorded only when the census is taken with --process-args."
}
approval {
  item: label_values_are_withheld
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:f85e22e159c177f1c6a5c2aab6fa7bc038880c648f82ca97e6cccafb4d3a86bb"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "A container label keeps its value only when its key is one of the well-known ones. Every other label is listed by its key alone, unless the census is taken with --all-label-values."
}
approval {
  item: only_a_local_engine_is_asked
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:35f37eb17b1ca7b788534f5383458eb1da2428c915c06ffdd5c9170952a7d4ce"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "A container engine is asked only through a local socket. An engine address of any other kind is refused: the scanner reports unavailable, names the setting and not the address, and lists no container."
}
approval {
  item: the_build_refuses_network_capable_code
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:c6fc27a0f8417fe108c016e900682d279a3f86c9023e4efc989ba0fa34d370fa"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "The dependency policy bans HTTP, TLS and Kubernetes client crates, the lints refuse TCP and UDP socket types, the engine client is built with its local transport only, and the lockfile holds none of the banned crates."
}
approval {
  item: the_bundle_format_is_pinned
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:e3540f34f728776e4a98971a4e48bc203c09d20ef055dd799a09018287626a7c"
  digest_version: 1
  links: [a_bundle_is_a_record_a_person_can_check: "sha256:0a3579ccbe7a92f103f0d2d02556632710a58a6d1649e47162d2089244d0681b"]
  text: "A fixed census serializes to the committed example bundle byte for byte."
}
approval {
  item: an_edited_inventory_is_refused
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:3ecdbc6e37d562b546869d7b5300632bd1386eb3fa96f62e937be2bd77607642"
  digest_version: 1
  links: [a_bundle_is_a_record_a_person_can_check: "sha256:0a3579ccbe7a92f103f0d2d02556632710a58a6d1649e47162d2089244d0681b"]
  text: "hostcensus refuses to add a mark to a bundle whose inventory no longer matches its fingerprint, and leaves the file as it was."
}
approval {
  item: a_mark_leaves_the_observations_alone
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:9ed78162b7b66d20feda0e28a30dbd6ec02bd66b16b206aef75b661c7e5c151f"
  digest_version: 1
  links: [coverage_is_stated_beside_the_observations: "sha256:c37aba02161e85042a40afeaf5d1e29d0971768599cf56bbb262edea32382eea"]
  text: "A mark records whether one source is collected, by what, to where, on what evidence and who said so. Adding it changes neither the inventory nor its fingerprint."
}
approval {
  item: only_a_source_in_the_census_can_be_marked
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:8bfe224fffa7cba7173a4d627d3ccbdb1b76783a64bc9a968f2b6a28b8389acb"
  digest_version: 1
  links: [coverage_is_stated_beside_the_observations: "sha256:c37aba02161e85042a40afeaf5d1e29d0971768599cf56bbb262edea32382eea"]
  text: "A source the census did not find cannot be marked. The command fails and the file is left as it was."
}
approval {
  item: a_pattern_marks_every_source_it_matches
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:838df8c3e3f65a6cf03c62d7cafdf12f90edaa6dc6f37a729c41aee286444ea4"
  digest_version: 1
  links: [coverage_is_stated_beside_the_observations: "sha256:c37aba02161e85042a40afeaf5d1e29d0971768599cf56bbb262edea32382eea"]
  text: "An identifier with a wildcard marks every source of that kind it matches, one mark per source, and the command names each source it marked."
}
approval {
  item: coverage_lists_every_source_with_its_mark
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:b71e1f4295edb3a94fa5344eaf9500b5085572d03b1ee23e1402313581126018"
  digest_version: 1
  links: [coverage_is_stated_beside_the_observations: "sha256:c37aba02161e85042a40afeaf5d1e29d0971768599cf56bbb262edea32382eea"]
  text: "hostcensus coverage prints one line per source the census found: yes, no, unknown or - for no mark, then the source, then the collector. It prints the totals on standard error and changes nothing."
}
