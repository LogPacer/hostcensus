approval {
  item: a_quiet_log_file_is_still_listed
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:ccf9844907ad2ccb3a1f41ce58718efed498d6f4d9edd90ac50dcc72236d48b5"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A log file that has not been written to for weeks is listed with the time of its last write. It is left out only past the age limit, which is 90 days unless another is given."
}
approval {
  item: a_container_says_where_its_output_goes
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:69776be0cead09c2a4c49df105d801ca2a7240c2ccf9ac2be231a3cc9549927e"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "A running container is listed with its logging driver and, where its log can be seen, the size of the log and the time it was last written to. The log is not opened."
}
