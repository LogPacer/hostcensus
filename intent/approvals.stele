approval {
  item: an_environment_value_is_kept_only_for_a_plain_fact
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:049a00ea8074224699323166bb9b4010390cdb6fd8eb44741dc43574e140672f"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "Every environment variable of a running container is listed by name. Its value is kept only when the name marks it as a version, the deployment environment, a log setting or a telemetry setting, and the value is a short plain token. Every other value is left out, whatever the variable is called."
}
approval {
  item: exclude_patterns_are_not_recorded
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:b2e4d572b8a0dddbbc31abe5907bb766a097a66f98dd5c2c5ff552795e24b321"
