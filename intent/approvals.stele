  text: "A process whose executable is an interpreter or a language runtime is listed with the script, jar, module or class it runs."
}
approval {
  item: a_process_is_recorded_without_its_arguments
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:8706d531085e9a490ea5b0f50e1061e0fae86f57c3a2e68d06fcbcff1e7f51ae"
  digest_version: 1
  links: [reveals_no_more_than_a_census_needs: "sha256:85102a690378072180d2831219862ef9aeeb4e1450899bfc624e7757c5ad9b77"]
  text: "Of the arguments a process was started with, only the one that names what an interpreter runs is recorded. Every other argument is left out unless the census is taken with --process-args."
}
