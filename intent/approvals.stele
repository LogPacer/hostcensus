}
approval {
  item: image_layers_are_not_searched_for_log_files
  kind: definition
  action: approve
  by: "MortenHusted"
  digest: "sha256:ba17461c35b858cf1a66b20721045af3a9d69976d4094ca5174b0886f05b7c8b"
  digest_version: 1
  links: [takes_a_census_of_one_host: "sha256:22764859d49ac5aaaa3244f936e8c77615693634d9a267244ffcb26b30b5ff66"]
  text: "The search for log files does not read a directory where a container runtime keeps the layers of its images. No file under it is listed, the rest of the runtime's data directory is searched, and the files scanner names each such directory as not searched."
}
